# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthcare?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=<your_jwt_secret_min_32_chars>
JWT_EXPIRES_IN=7d

# ─── Gemini LLM ───────────────────────────────────────────
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=10000

# ─── Nodemailer (Gmail example) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your_email@gmail.com>
SMTP_PASS=<your_gmail_app_password>
EMAIL_FROM=Healthcare App <your_email@gmail.com>

# ─── Google Calendar OAuth 2.0 ────────────────────────────
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# ─── Frontend URL (for CORS + OAuth redirects) ────────────
CLIENT_URL=http://localhost:3000

# ─── Slot Hold Duration ───────────────────────────────────
HOLD_DURATION_MINUTES=5

# ─── Notification Retry ───────────────────────────────────
MAX_NOTIFICATION_RETRIES=5
